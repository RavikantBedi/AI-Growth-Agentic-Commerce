# ---------------------------------------------------------------------------
# AI Merchant Growth & Agentic Checkout — example environment
# Copy to .env  ->  cp .env.example .env
# NEVER commit the real .env file.
# ---------------------------------------------------------------------------

APP_ENV=development
LOG_LEVEL=INFO

# SQLite by default. Swap for postgresql+psycopg://... to move to Postgres.
DATABASE_URL=sqlite:///./data/commerce.db

# CORS origins for the Vite dev server (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# AI provider — all optional. The app is fully functional with none of them.
#
#   auto   -> local Ollama if reachable, else Groq, else Gemini, else Claude,
#             else the deterministic planner
#   ollama -> require a local Ollama install
#   groq   -> free cloud tier, open-weight models  (recommended if no Ollama)
#   gemini -> free cloud tier from Google AI Studio
#   claude -> optional, requires ANTHROPIC_API_KEY
#   mock   -> always deterministic (best for reproducible demos / CI)
# ---------------------------------------------------------------------------
LLM_PROVIDER=auto
LLM_TIMEOUT_SECONDS=20

# --- Local, free, private. Install: https://ollama.com  then: ollama pull llama3.2
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- Groq: free key at https://console.groq.com/keys  (no card required)
# Fast, and runs open-weight models. The simplest way to get real conversation
# without installing anything.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Gemini: free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# --- Claude: optional, paid. Not required for the demo.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ---------------------------------------------------------------------------
# Razorpay — TEST MODE ONLY.
# Get free test keys at https://dashboard.razorpay.com  (Test Mode -> API Keys)
# Test key ids always start with "rzp_test_". The app REFUSES rzp_live_ keys.
# Leave blank to run the clearly-labelled local sandbox provider instead.
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_TIMEOUT_SECONDS=15

# ---------------------------------------------------------------------------
# Money / policy guardrails. Values are in rupees (converted to paise inside).
# The AI can never exceed these, regardless of what it is told to do.
# ---------------------------------------------------------------------------
MAX_ORDER_VALUE=100000
MAX_DISCOUNT_PERCENT=20
MAX_CAMPAIGN_BUDGET=50000
MAX_ITEMS_PER_ORDER=20
MAX_QUANTITY_PER_LINE=5
REQUIRE_PAYMENT_CONFIRMATION=true
ALLOWED_CURRENCY=INR

# Tax (GST). Set TAX_PERCENT=0 to disable tax entirely.
TAX_PERCENT=18

# How long a prepared checkout quote stays valid before it must be re-quoted.
QUOTE_TTL_SECONDS=600
